% ============================================================
% tema-maestria.sty
% Plantilla visual reutilizable para diapositivas de la Maestria
% en Ciencia de Datos (UNSA), calcada del diseno de la
% Practica 1 - 3 V's del Big Data (exportado a PDF por Google Slides).
%
% Uso (con xelatex, desde la carpeta de la practica):
%   \documentclass[aspectratio=43]{beamer}
%   \usepackage{../plantilla-diapositivas/tema-maestria}
%   \setnav{5}{{Introducción},{Segunda},{Tercera},{Cuarta},{Quinta}}
%   \setfootizq{Maestría en Ciencia de Datos}
%   \setfootder{Nombre del curso o actividad}
%   \begin{document}
%     \activarnav{1}
%     \begin{frame} ... \end{frame}
%   \end{document}
% ============================================================
\ProvidesPackage{tema-maestria}[2026/09/19 v1.0 Tema visual Maestria UNSA]

\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{fontawesome5}
\RequirePackage{xcolor}
\RequirePackage{fontspec}

% ---------------- Colores (muestreados del PDF original) ----------------
\definecolor{cNavy}{HTML}{003A80}     % barra activa / pildoras de titulo
\definecolor{cLime}{HTML}{B4EB43}     % barra de navegacion / pie izq.
\definecolor{cLimeDark}{HTML}{7FA22F} % circulos de check, acentos
\definecolor{cBg}{HTML}{F6F6F6}       % fondo de la diapositiva
\definecolor{cText}{HTML}{1A1A1A}     % texto de cuerpo

% ---------------- Tipografia ----------------
\setmainfont{Noto Sans}
\newfontfamily\semifont{Noto Sans SemiBold}
\newfontfamily\medfont{Noto Sans Medium}

% ---------------- Configuracion base de beamer ----------------
\setbeamercolor{background canvas}{bg=cBg}
\setbeamercolor{normal text}{fg=cText}
\setbeamercolor{frametitle}{fg=cText}
\setbeamercolor{itemize item}{fg=cNavy}
\setbeamercolor{itemize subitem}{fg=cLimeDark}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize items}[circle]
\setbeamerfont{frametitle}{series=\bfseries}
\setlength{\parskip}{2pt}

% ---------------- Barra de navegacion superior ----------------
% \setnav{<n>}{{Tab1},{Tab2},...}  -- n = numero de pestanas, lista en llaves
\newcommand{\navtotal}{5}
\newcommand{\navitems}{{Introducción},{Segunda},{Tercera},{Cuarta},{Quinta}}
\newcommand{\setnav}[2]{\renewcommand{\navtotal}{#1}\renewcommand{\navitems}{#2}}

% \activarnav{<i>} -- indica que pestana (1..n) esta activa en el frame actual
\newcommand{\navactiva}{1}
\newcommand{\activarnav}[1]{\renewcommand{\navactiva}{#1}}

\newlength{\navh}
\setlength{\navh}{0.62cm}

\setbeamertemplate{headline}{%
  \begin{tikzpicture}[x=1pt,y=1pt]
    \path[use as bounding box] (0,0) rectangle (\paperwidth,\navh);
    \pgfmathsetmacro{\tabw}{\paperwidth/\navtotal}
    \foreach \nombre [count=\k] in \navitems {
      \pgfmathsetmacro{\xleft}{(\k-1)*\tabw}
      \ifnum\k=\navactiva\relax
        \fill[cNavy] (\xleft,0) rectangle ({\xleft+\tabw},\navh);
        \node[white, font=\semifont\footnotesize] at ({\xleft+\tabw/2},{\navh/2}) {\nombre};
      \else
        \fill[cLime] (\xleft,0) rectangle ({\xleft+\tabw},\navh);
        \node[white, font=\footnotesize] at ({\xleft+\tabw/2},{\navh/2}) {\nombre};
      \fi
    }
  \end{tikzpicture}%
}

% ---------------- Pie de pagina (dos mitades) ----------------
\newcommand{\footizq}{Maestría en Ciencia de Datos}
\newcommand{\footder}{Actividad}
\newcommand{\setfootizq}[1]{\renewcommand{\footizq}{#1}}
\newcommand{\setfootder}[1]{\renewcommand{\footder}{#1}}

\newlength{\footh}
\setlength{\footh}{0.5cm}

\setbeamertemplate{footline}{%
  \begin{tikzpicture}[x=1pt,y=1pt]
    \path[use as bounding box] (0,0) rectangle (\paperwidth,\footh);
    \fill[cLime] (0,0) rectangle ({\paperwidth/2},\footh);
    \fill[cNavy] ({\paperwidth/2},0) rectangle (\paperwidth,\footh);
    \node[white, font=\semifont\scriptsize] at ({\paperwidth/4},{\footh/2}) {\footizq};
    \node[white, font=\semifont\scriptsize] at ({3*\paperwidth/4},{\footh/2}) {\footder};
  \end{tikzpicture}%
}

% ---------------- Pildoras de titulo (redondeadas, fondo navy) ----------------
% Pildora grande, centrada -- para portadas / cierre
\newcommand{\portadapill}[1]{%
  \begin{center}
  \tikz\node[fill=cNavy, rounded corners=12pt, text=white, font=\bfseries\Large,
             inner xsep=18pt, inner ysep=10pt, text width=0.78\paperwidth, align=center]
             {#1};
  \end{center}%
}

% Pildora pequena, alineada a la izquierda -- para encabezado de seccion dentro de una diapositiva
\newcommand{\seccionpill}[1]{%
  \tikz\node[fill=cNavy, rounded corners=7pt, text=white, font=\bfseries\large,
             inner xsep=12pt, inner ysep=6pt, align=left] {#1};
}

% ---------------- Lista con check verde (estilo "Variedad de datos") ----------------
\newcommand{\itemcheck}[2]{%
  % #1 = titulo corto en negrita, #2 = texto/descripcion
  \par\noindent
  \begin{tikzpicture}[baseline=(C.base)]
    \node[circle, fill=cLimeDark, minimum size=13pt, inner sep=0pt] (C) {\textcolor{white}{\footnotesize\faIcon[regular]{check}}};
  \end{tikzpicture}%
  \hspace{5pt}{\small\bfseries #1}\par
  \hspace{22pt}\parbox{0.85\linewidth}{\footnotesize #2}\par\vspace{2pt}%
}

% ---------------- Tarjeta de icono + texto (para pipelines / pasos) ----------------
\newcommand{\iconstep}[3]{%
  % #1 = icono FontAwesome (sin barra), #2 = titulo, #3 = ancho de caja
  \begin{minipage}[t]{#3}
    \centering
    \tikz\node[circle, fill=cNavy, minimum size=34pt, inner sep=0pt]
      {\textcolor{white}{\Large\csname fa#1\endcsname}};\\[4pt]
    {\small\bfseries\color{cNavy} #2}
  \end{minipage}%
}

\endinput
